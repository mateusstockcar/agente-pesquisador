# Copie este arquivo para .env e preencha (o .env NUNCA vai para o GitHub)

# Gemini (gratuito): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelo reserva se o principal estiver sobrecarregado (veja os nomes no AI Studio)
GEMINI_FALLBACK_MODEL=
# Modelo do juiz dos evals: diferente e mais forte que o do agente
GEMINI_JUDGE_MODEL=gemini-3.5-flash

# Langfuse (plano gratuito): https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Busca na web (gratuito, 1.000 buscas/mês): https://app.tavily.com
TAVILY_API_KEY=
